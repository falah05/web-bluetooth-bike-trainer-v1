{
  "name": "web-bluetooth-bike-trainer",
  "version": "1.0.0",
  "description": "Aplikasi desktop bike trainer via Web Bluetooth",
  "author": "Falah",
  "main": "main.js",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "build:electron": "ng build --configuration production --base-href ./",
    "start:electron": "npm run build:electron && electron .",
    "dist:win": "npm run build:electron && electron-builder --win"
  },
  "build": {
    "appId": "com.mff.biketrainer",
    "productName": "Bike Trainer",
    "directories": {
      "output": "installers"
    },
    "files": [
      "main.js",
      "dist/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "18.2.12",
    "@angular/animations": "18.2.13",
    "@angular/cdk": "18.2.14",
    "@angular/cli": "18.2.12",
    "@angular/common": "18.2.13",
    "@angular/compiler": "18.2.13",
    "@angular/compiler-cli": "18.2.13",
    "@angular/core": "18.2.13",
    "@angular/forms": "18.2.13",
    "@angular/material": "18.2.14",
    "@angular/platform-browser": "18.2.13",
    "@angular/platform-browser-dynamic": "18.2.13",
    "@angular/router": "18.2.13",
    "@types/jasmine": "5.1.5",
    "@types/leaflet": "1.9.15",
    "@types/leaflet-gpx": "1.3.7",
    "@types/web-bluetooth": "0.0.20",
    "angular-eslint": "19.0.2",
    "electron": "38.4.0",
    "electron-builder": "^26.0.12",
    "eslint": "9.17.0",
    "jasmine-core": "5.2.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "leaflet": "1.9.4",
    "leaflet-gpx": "1.7.0",
    "ngx-gauge": "10.0.0",
    "ngx-toastr": "19.0.0",
    "rxjs": "7.8.1",
    "tslib": "2.8.1",
    "typescript": "5.5.4",
    "typescript-eslint": "8.18.0",
    "ws": "8.21.0",
    "zone.js": "0.14.10"
  }
}